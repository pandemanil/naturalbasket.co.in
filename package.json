{
  "name": "natural-basket",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply natural-basket-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply natural-basket-db --remote",
    "pages:dev": "wrangler pages dev dist --d1=DB --r2=IMAGES",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wrangler": "^3.84.0"
  }
}
